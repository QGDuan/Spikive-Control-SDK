<?xml version="1.0"?>
<package format="2">
  <name>spikive_control_sdk</name>
  <version>0.3.0</version>
  <description>ROS1 takeoff, land and goto action adapters for the existing Spikive control chain.</description>
  <maintainer email="user@example.com">Spikive</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>mavros</exec_depend>
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>controller_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
</package>
