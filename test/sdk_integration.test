<launch>
  <!-- rostest 启动隔离 master；真实硬件/飞控不参与。 -->
  <param name="use_sim_time" value="false"/>
  <include file="$(find spikive_control_sdk)/launch/spikive_control_sdk.launch">
    <arg name="drone_id" value="42"/>
  </include>
  <param name="/spikive_flight_node/goto/stable_time" value="0.15"/>
  <test test-name="sdk_v14_integration" pkg="spikive_control_sdk" type="sdk_integration_test.py" time-limit="100"/>
</launch>
